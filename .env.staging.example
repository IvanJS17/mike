# Reproducible local staging environment for Beta Juridica 0.1.
#
# Copy this file to .env.staging, replace every placeholder, and keep the copy
# local. scripts/staging-up rejects empty/example values and invalid ports.
# Secrets must be synthetic and dedicated to this disposable local project.
# Use hexadecimal values for the password/signing/encryption fields so the
# internal Postgres URL needs no URL escaping.

STAGING_COMPOSE_PROJECT=mike-staging
STAGING_PROXY_PORT=55421
STAGING_PUBLIC_URL=http://localhost:55421
STAGING_DISABLE_SIGNUP=true

STAGING_POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
STAGING_JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET
STAGING_SUPABASE_ANON_KEY=CHANGE_ME_STAGING_SUPABASE_ANON_KEY
STAGING_SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_STAGING_SUPABASE_SERVICE_ROLE_KEY
STAGING_DOWNLOAD_SIGNING_SECRET=CHANGE_ME_STAGING_DOWNLOAD_SIGNING_SECRET
STAGING_USER_API_KEYS_ENCRYPTION_SECRET=CHANGE_ME_STAGING_USER_API_KEYS_ENCRYPTION_SECRET
