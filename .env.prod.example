# Deployment interpolation file. Copy outside the repository to the encrypted
# secrets directory, chmod 600, and replace every placeholder before `compose.prod.yml`.
# The example contains no usable credentials or image references.

APP_DOMAIN=litt.example.invalid
ACME_EMAIL=ops@example.invalid
SOURCE_OFFER_URL=https://github.com/IvanJS17/mike/tree/REPLACE_WITH_RELEASE_SHA
RELEASE_SHA=REPLACE_WITH_FULL_RELEASE_SHA
RELEASE_MANIFEST_PATH=/srv/litt-data/state/release-manifest.json
LITT_DATA_ROOT=/srv/litt-data
LITT_SECRETS_ROOT=/srv/litt-data/secrets

# CI outputs immutable image references. Tags without @sha256 are rejected.
LITT_CADDY_IMAGE=caddy:2.10.0@sha256:REPLACE_WITH_CI_DIGEST
LITT_FRONTEND_IMAGE=ghcr.io/ivanjs17/litt-frontend@sha256:REPLACE_WITH_CI_DIGEST
LITT_BACKEND_IMAGE=ghcr.io/ivanjs17/litt-backend@sha256:REPLACE_WITH_CI_DIGEST
LITT_DB_IMAGE=supabase/postgres:17.6.1.136@sha256:REPLACE_WITH_VERIFIED_DIGEST
LITT_AUTH_IMAGE=supabase/gotrue:v2.189.0@sha256:REPLACE_WITH_VERIFIED_DIGEST
LITT_REST_IMAGE=postgrest/postgrest:v14.12@sha256:REPLACE_WITH_VERIFIED_DIGEST

# The following values belong in the separate files under LITT_SECRETS_ROOT,
# not in this file: db.env, auth.env, rest.env, and backend.env.
