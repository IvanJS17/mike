# LiTT — contrato de variables de producción.
# Copiar a /srv/litt/.env (chmod 600) y llenar. NUNCA versionar el .env real.
# Usar SIEMPRE con: docker compose --env-file /srv/litt/.env -f deploy/prod/compose.yaml

# URL pública del servicio (Caddy + DNS ya configurados).
PUBLIC_URL=https://litt.asteroitt.com.mx

# Etiqueta del release (sha corto del commit de main desplegado; retag de las
# imágenes verificadas — ver README §Imágenes).
LITT_RELEASE=

# Generar cada uno con: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
DOWNLOAD_SIGNING_SECRET=
USER_API_KEYS_ENCRYPTION_SECRET=

# JWT de Supabase (rol anon | service_role), firmados con JWT_SECRET.
# Generar con: JWT_SECRET=<el de arriba> python3 deploy/prod/supabase-jwt.py anon
SUPABASE_ANON_KEY=
# JWT_SECRET=<el de arriba> python3 deploy/prod/supabase-jwt.py service_role
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (almacén de documentos). Credenciales S3 del bucket dedicado.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=litt-docs

# Arranque: signup abierto (aún sin SMTP); poner true cuando todo el equipo
# tenga cuenta (reinicia auth para aplicar).
DISABLE_SIGNUP=false
